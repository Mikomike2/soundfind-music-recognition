# ==========================================
# SoundFind Music Recognition Environment
# ==========================================

# Primary Music Recognition API: AudD (Recommended)
# Get a free API token with 300 free requests at: https://audd.io
# You can also use "test" for limited trial testing
AUDD_API_TOKEN="test"

# Optional: ACRCloud API (Alternative Provider)
# Register at: https://www.acrcloud.com
ACRCLOUD_HOST=""
ACRCLOUD_ACCESS_KEY=""
ACRCLOUD_ACCESS_SECRET=""

# Optional: Supabase for persistent cloud history
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
